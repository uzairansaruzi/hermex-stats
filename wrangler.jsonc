{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermex-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "account_id": "7ed8875c893d68526eb5c4aef7bce676",
  // Only the custom domain serves traffic, so every report passes the zone's rate limiting rule.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hermex-stats.uzairansar.com", "custom_domain": true }],
  "d1_databases": [
    // Replace database_id with the ID `wrangler d1 create hermex-stats` prints.
    { "binding": "DB", "database_name": "hermex-stats", "database_id": "06520fd8-f236-4beb-b41c-b4e9d4b9c4a3", "migrations_dir": "migrations" }
  ],
  "vars": {
    // The Zero Trust team domain and the dashboard Access application's Audience (AUD) tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Request logs would hold the connecting address. Keep logs, traces and Logpush off.
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "logpush": false
}
